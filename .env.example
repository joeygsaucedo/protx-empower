# Public site origin used for canonical tags, Open Graph URLs, robots.txt and
# the sitemap.
PUBLIC_SITE_URL=https://protxempower.com

# Contact form email. For Gmail / Google Workspace, SMTP_PASS must be an app
# password from https://myaccount.google.com/apppasswords, not the account
# password. Keep SMTP_FROM_EMAIL the same as SMTP_USER unless it is a verified
# "Send mail as" alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@protxempower.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_EMAIL=support@protxempower.com
SMTP_FROM_NAME=Protect and Empower
CONTACT_EMAIL_TO=support@protxempower.com
