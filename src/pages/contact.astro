---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { BUSINESS } from '../lib/site';

const { street, city, region, postalCode } = BUSINESS.address;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${street}, ${city}, ${region} ${postalCode}`)}`;
const inputClass =
  'mt-2 block w-full rounded-lg border border-sand-300 bg-white px-4 py-3 text-ink-900 placeholder:text-ink-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200';
---

<Layout
  title={`Contact | ${BUSINESS.name}`}
  description="Schedule a confidential consultation with Protect and Empower. Call (818) 209-0438 or send us a message."
>
  <PageHeader
    eyebrow="Contact"
    title="Let's talk"
    intro="Tell us about your situation. Everything you share is kept strictly confidential."
  />

  <section class="py-20">
    <div class="container mx-auto grid max-w-6xl gap-12 px-4 lg:grid-cols-[1fr_1.4fr]">
      <!-- Details -->
      <div class="space-y-8">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-500 font-body">Phone</h2>
          <a href={`tel:${BUSINESS.phone}`} class="mt-2 block font-heading text-2xl font-semibold hover:text-brand-600">{BUSINESS.phoneDisplay}</a>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-500 font-body">Email</h2>
          <a href={`mailto:${BUSINESS.email}`} class="mt-2 block text-lg font-semibold break-all hover:text-brand-600">{BUSINESS.email}</a>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-500 font-body">Office</h2>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-2 block text-lg hover:text-brand-600">
            {street}<br />{city}, {region} {postalCode}
          </a>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-500 font-body">Business hours</h2>
          <dl class="mt-2 space-y-1 text-lg">
            {BUSINESS.hours.map((h) => (
              <div class="flex justify-between gap-6 border-b border-sand-200 py-2">
                <dt>{h.days}</dt>
                <dd class="text-ink-600">{h.time}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- Form -->
      <form id="contact-form" class="rounded-2xl border border-sand-200 bg-white p-8 shadow-sm md:p-10" novalidate>
        <h2 class="text-3xl font-semibold">Send us a message</h2>
        <p class="mt-2 text-ink-600">We'll get back to you as soon as possible.</p>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <label class="block sm:col-span-2">
            <span class="font-medium">Name <span class="text-brand-600">*</span></span>
            <input name="name" type="text" autocomplete="name" required maxlength="200" class={inputClass} />
          </label>
          <label class="block">
            <span class="font-medium">Email <span class="text-brand-600">*</span></span>
            <input name="email" type="email" autocomplete="email" required maxlength="254" class={inputClass} />
          </label>
          <label class="block">
            <span class="font-medium">Phone</span>
            <input name="phone" type="tel" autocomplete="tel" maxlength="40" class={inputClass} />
          </label>
          <label class="block sm:col-span-2">
            <span class="font-medium">How can we help? <span class="text-brand-600">*</span></span>
            <textarea name="message" rows="6" required maxlength="5000" class={inputClass}></textarea>
          </label>
          <!-- Honeypot: hidden from people, filled in by bots. -->
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label>Company website <input name="company-website" type="text" tabindex="-1" autocomplete="off" /></label>
          </div>
        </div>

        <button type="submit" class="btn-primary mt-8 w-full sm:w-auto">Send message</button>
        <p id="form-status" class="mt-4 hidden rounded-lg px-4 py-3" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  const showStatus = (message: string, ok: boolean) => {
    if (!status) return;
    status.textContent = message;
    status.className = `mt-4 rounded-lg px-4 py-3 ${ok ? 'bg-green-50 text-green-800' : 'bg-brand-50 text-brand-800'}`;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled = true;
    button.textContent = 'Sending...';

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = (await response.json()) as { success: boolean; message: string };
      showStatus(result.message, result.success);
      if (result.success) form.reset();
    } catch {
      showStatus('Something went wrong. Please call us at (818) 209-0438.', false);
    } finally {
      button.disabled = false;
      button.textContent = 'Send message';
    }
  });
</script>
