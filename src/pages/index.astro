---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS } from '../lib/site';
import { PROCESS_STEPS, SERVICES, TESTIMONIALS } from '../lib/content';

const values = [
  { icon: 'shield', title: 'Built for public sector employees', body: 'Our work centers on the people who serve their communities and the workplace issues they face.' },
  { icon: 'lock', title: 'Strictly confidential', body: 'Everything shared in consultations and mediation stays private.' },
  { icon: 'scale', title: 'Attorney referrals when needed', body: 'If your situation calls for legal action, we connect you with employment law attorneys.' },
] as const;
---

<Layout title={`${BUSINESS.name} | Workplace Mediation for Public Sector Employees`}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(192,42,51,0.35),transparent_55%)]"></div>
    <div class="pointer-events-none absolute inset-0 opacity-[0.07] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:48px_48px]"></div>

    <div class="container relative mx-auto grid items-center gap-16 px-4 py-24 md:py-32 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="eyebrow !text-brand-300">Protect and Empower</p>
        <h1 class="mt-5 text-5xl font-semibold leading-[1.05] md:text-6xl lg:text-7xl">
          Fighting for dignity in the workplace.
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-200 md:text-xl">
          Expert conflict resolution and mediation for public sector employees. We address employment and
          workplace law issues with professionalism and care, and help you reach effective solutions.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href="/contact" class="btn-primary text-lg">Request a free consultation</a>
          <a href="/services" class="btn-secondary text-lg text-white hover:bg-white/10">Explore our services</a>
        </div>
      </div>

      <!-- Hero card: quick contact -->
      <div class="rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur">
        <p class="font-heading text-2xl font-semibold">Talk to someone today</p>
        <p class="mt-2 text-ink-300">Confidential. No obligation.</p>
        <div class="mt-8 space-y-5">
          <a href={`tel:${BUSINESS.phone}`} class="group flex items-center gap-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-600 transition-colors group-hover:bg-brand-500">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.28 6.72 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.37c0-.52-.35-.97-.85-1.09l-4.42-1.1c-.44-.11-.9.05-1.17.41l-.97 1.29a1.13 1.13 0 0 1-1.21.38 12.04 12.04 0 0 1-7.14-7.14c-.16-.47.01-.97.38-1.21l1.29-.97c.36-.27.52-.73.41-1.17l-1.1-4.42a1.13 1.13 0 0 0-1.09-.85H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg>
            </span>
            <span>
              <span class="block text-sm text-ink-300">Call us</span>
              <span class="block text-lg font-semibold">{BUSINESS.phoneDisplay}</span>
            </span>
          </a>
          <a href={`mailto:${BUSINESS.email}`} class="group flex items-center gap-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10 transition-colors group-hover:bg-white/20">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.24a2.25 2.25 0 0 1-1.07 1.92l-7.5 4.61a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.92V6.75"/></svg>
            </span>
            <span>
              <span class="block text-sm text-ink-300">Email us</span>
              <span class="block text-lg font-semibold break-all">{BUSINESS.email}</span>
            </span>
          </a>
        </div>
        <p class="mt-8 border-t border-white/10 pt-6 text-sm text-ink-300">
          Office hours: Monday to Friday, 9:00 am to 6:00 pm
        </p>
      </div>
    </div>
  </section>

  <!-- Values strip -->
  <section class="border-b border-sand-200 bg-white">
    <div class="container mx-auto grid gap-10 px-4 py-14 md:grid-cols-3">
      {
        values.map((v) => (
          <div class="flex gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
              <Icon name={v.icon} />
            </span>
            <div>
              <h2 class="font-body text-base font-semibold text-ink-900">{v.title}</h2>
              <p class="mt-1 text-sm leading-relaxed text-ink-600">{v.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Services -->
  <section class="py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl">
        <p class="eyebrow">What we do</p>
        <h2 class="mt-3 text-4xl font-semibold md:text-5xl">Support at every stage of a workplace conflict</h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {
          SERVICES.map((s) => (
            <a
              href={`/services#${s.slug}`}
              class="group rounded-2xl border border-sand-200 bg-white p-8 transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-lg"
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-ink-900 text-white transition-colors group-hover:bg-brand-600">
                <Icon name={s.icon} />
              </span>
              <h3 class="mt-6 text-2xl font-semibold">{s.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-600">{s.summary}</p>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
                Learn more
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-sand-100 py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl">
        <p class="eyebrow">How it works</p>
        <h2 class="mt-3 text-4xl font-semibold md:text-5xl">A clear path forward</h2>
      </div>
      <ol class="mt-14 grid gap-10 md:grid-cols-3">
        {
          PROCESS_STEPS.map((step, i) => (
            <li class="relative">
              <span class="font-heading text-6xl font-semibold text-brand-200">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-2 text-2xl font-semibold">{step.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-600">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl">
        <p class="eyebrow">Client voices</p>
        <h2 class="mt-3 text-4xl font-semibold md:text-5xl">What our clients say</h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {
          TESTIMONIALS.map((t) => (
            <figure class="flex flex-col rounded-2xl bg-white p-8 shadow-sm ring-1 ring-sand-200">
              <svg class="h-8 w-8 text-brand-200" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
                <path d="M9.3 26C5.8 26 3 23.2 3 19.4 3 13.6 7.3 8 13.4 6l1.3 2.2c-3.6 1.6-5.8 4.6-5.9 7.3h.9c3 0 5.4 2.3 5.4 5.2S12.6 26 9.3 26Zm15.9 0c-3.5 0-6.3-2.8-6.3-6.6 0-5.8 4.3-11.4 10.4-13.4l1.3 2.2c-3.6 1.6-5.8 4.6-5.9 7.3h.9c3 0 5.4 2.3 5.4 5.2S28.5 26 25.2 26Z" />
              </svg>
              <blockquote class="mt-4 flex-1 text-lg leading-relaxed text-ink-800">{t.quote}</blockquote>
              <figcaption class="mt-6 font-semibold text-ink-900">{t.author}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
