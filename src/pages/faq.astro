---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { BUSINESS } from '../lib/site';
import { FAQS } from '../lib/content';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<Layout
  title={`FAQ | ${BUSINESS.name}`}
  description="Answers to common questions about our mediation and consultation services, scheduling, and confidentiality."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <PageHeader eyebrow="FAQ" title="Frequently asked questions" />

  <section class="py-20">
    <div class="container mx-auto max-w-3xl px-4">
      <div class="divide-y divide-sand-200 rounded-2xl border border-sand-200 bg-white">
        {
          FAQS.map((f, i) => (
            <details class="group p-6 md:p-8" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-xl font-semibold text-ink-900 [&::-webkit-details-marker]:hidden">
                <span class="font-heading">{f.question}</span>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sand-100 text-brand-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-4 text-lg leading-relaxed text-ink-600">{f.answer}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-10 text-center text-ink-600">
        Have a different question? <a href="/contact" class="font-semibold text-brand-600 hover:underline">Get in touch</a>.
      </p>
    </div>
  </section>

  <CtaBand />
</Layout>
