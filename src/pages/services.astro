---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { BUSINESS } from '../lib/site';
import { SERVICES } from '../lib/content';
---

<Layout
  title={`Services | ${BUSINESS.name}`}
  description="Conflict resolution, mediation, ongoing guidance, and employee group consultations on employment and workplace law for public sector employees."
>
  <PageHeader
    eyebrow="Services"
    title="How we help public sector employees"
    intro="From a single consultation to mediation with your employer, we support you through every step of a workplace conflict."
  />

  <section class="py-20">
    <div class="container mx-auto max-w-5xl space-y-6 px-4">
      {
        SERVICES.map((s, i) => (
          <article
            id={s.slug}
            class="scroll-mt-28 grid gap-6 rounded-2xl border border-sand-200 bg-white p-8 md:grid-cols-[auto_1fr] md:gap-10 md:p-10"
          >
            <div class="flex items-start gap-4 md:flex-col">
              <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-ink-900 text-white">
                <Icon name={s.icon} class="h-7 w-7" />
              </span>
              <span class="font-heading text-4xl font-semibold text-brand-200">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div>
              <h2 class="text-3xl font-semibold">{s.title}</h2>
              <p class="mt-4 text-lg leading-relaxed text-ink-600">{s.summary}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Layout>
