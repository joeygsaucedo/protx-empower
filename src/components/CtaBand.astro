---
import { BUSINESS } from '../lib/site';

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = 'Facing a workplace issue? You don’t have to handle it alone.',
  body = 'Tell us what’s happening. Consultations are confidential, and we’ll help you understand your options.',
} = Astro.props;
---

<section class="bg-brand-700 text-white">
  <div class="container mx-auto flex flex-col items-start gap-8 px-4 py-16 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold md:text-4xl">{heading}</h2>
      <p class="mt-3 text-lg text-brand-100">{body}</p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <a href="/contact" class="btn-primary !bg-white !text-brand-700 hover:!bg-brand-50">Request a consultation</a>
      <a href={`tel:${BUSINESS.phone}`} class="btn-secondary text-white hover:bg-white/10">Call {BUSINESS.phoneDisplay}</a>
    </div>
  </div>
</section>
