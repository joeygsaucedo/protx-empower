---
// Placeholder mark until a clean, full-resolution logo file is available.
// The old site's handshake logo is cropped at the source, so it isn't reused.
interface Props {
  inverted?: boolean;
}

const { inverted = false } = Astro.props;
---

<span class="flex items-center gap-3">
  <svg class="h-10 w-10 shrink-0" viewBox="0 0 40 40" aria-hidden="true">
    <path
      d="M20 3 6 8.5v10.2C6 27.5 12 34.6 20 37c8-2.4 14-9.5 14-18.3V8.5L20 3Z"
      class="fill-brand-600"
    />
    <path
      d="m13.5 20.5 4.5 4.5 8.5-9"
      fill="none"
      stroke="white"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`font-heading text-xl font-bold ${inverted ? 'text-white' : 'text-ink-900'}`}>
      Protect <span class="text-brand-600">&amp;</span> Empower
    </span>
    <span class={`mt-1 text-[0.7rem] font-medium uppercase tracking-[0.2em] ${inverted ? 'text-ink-300' : 'text-ink-500'}`}>
      Workplace Advocacy
    </span>
  </span>
</span>
